# Replit run configuration for the Centaur Zendo game server.
# The server binds 0.0.0.0 and honours $PORT, which Replit sets (8080 here).
run = "python -m engine.server --config game.json"
entrypoint = "engine/server.py"
modules = ["python-3.11"]

[nix]
channel = "stable-23_11"
packages = ["python311", "python311Packages.pip"]

[env]
PYTHONUNBUFFERED = "1"
PORT = "8080"

[deployment]
run = ["sh", "-c", "python -m engine.server --config game.json"]
deploymentTarget = "cloudrun"
ignorePorts = false

[[ports]]
localPort = 8080
externalPort = 80

[unitTest]
language = "python3"
